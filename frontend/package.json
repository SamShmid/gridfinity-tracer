{
  "name": "gridfinity-tracer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}' index.html vite.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}' index.html vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "prettier": "^3.9.9",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
